{
    "name": "historic-city-map",
    "version": "1.0.0-beta.1",
    "private": true,
    "description": "Historic City Map Maker monorepo: a historical map engine and admin for any city (viewer engine, admin, shared kit, Firebase backend and raster pipeline; example: București dispărut).",
    "license": "UNLICENSED",
    "type": "module",
    "engines": {
        "node": ">=24.12.0"
    },
    "workspaces": [
        "packages/*",
        "functions",
        "firebase/rules-tests",
        "e2e"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present && node --import ./scripts/site/register-ts.mjs scripts/site/build-admin.ts",
        "build:admin": "npm run build --workspace @hcm/admin && node --import ./scripts/site/register-ts.mjs scripts/site/build-admin.ts",
        "build:hosting": "npm run build:admin && npm run build --workspace @hcm/engine && node --import ./scripts/site/register-ts.mjs scripts/site/build-hosting.ts",
        "build:install": "npm run build --workspace @hcm/functions && node --import ./scripts/site/register-ts.mjs scripts/site/build-install.ts",
        "split:admin-site": "node --import ./scripts/site/register-ts.mjs scripts/site/split-admin-site.ts",
        "build:start": "node --import ./scripts/site/register-ts.mjs scripts/site/build-start.ts",
        "build:landing": "node --import ./scripts/site/register-ts.mjs scripts/site/build-landing.ts",
        "build:site": "node --import ./scripts/site/register-ts.mjs scripts/site/build-site.ts --pages dist/pages --pages-redirect dist/pages-redirect",
        "site:add": "node --import ./scripts/site/register-ts.mjs scripts/site/add-site.ts",
        "build:self-host": "npm run build:hosting && npm run build --workspace @hcm/functions && npm run build:start && node --import ./scripts/site/register-ts.mjs packages/create-historic-city/build-self-host.ts",
        "build:site:e2e": "npm run build --workspace @hcm/engine && npm run build --workspace create-historic-city && npm run build --workspace @hcm/functions && npm run build:e2e --workspace @hcm/admin && node --import ./scripts/site/register-ts.mjs e2e/scripts/build-site.ts",
        "dev:stack": "bash scripts/dev/dev-stack.sh",
        "emulators:setup": "firebase setup:emulators:firestore && firebase setup:emulators:storage && firebase setup:emulators:pubsub",
        "format": "prettier --write .",
        "format:check": "prettier --check --cache --cache-location reports/.cache/prettier/cache.json .",
        "lint": "bash scripts/ci/lint.sh",
        "lint:changed": "bash scripts/ci/lint-changed.sh",
        "lint:css": "stylelint --cache --cache-location reports/.cache/stylelint/ --cache-strategy content --max-warnings 0 --report-needless-disables --report-invalid-scope-disables --report-descriptionless-disables \"packages/*/src/**/*.{css,ts}\"",
        "lint:deps": "depcruise packages functions e2e firebase/rules-tests scripts/site scripts/release --config .dependency-cruiser.cjs",
        "lint:html": "htmlhint",
        "lint:html:validate": "html-validate --max-warnings 0",
        "lint:knip": "knip",
        "lint:md": "markdownlint-cli2",
        "release:bump": "node --import ./scripts/site/register-ts.mjs scripts/release/bump.ts",
        "release:cdn": "node --import ./scripts/site/register-ts.mjs scripts/release/cdn.ts",
        "release:notes": "node --import ./scripts/site/register-ts.mjs scripts/release/notes-sri.ts",
        "release:pin-kit": "node --import ./scripts/site/register-ts.mjs scripts/release/pin-kit.ts",
        "seed:migrate": "node scripts/seed/migrate-legacy.mjs",
        "stack:check": "node --import ./scripts/site/register-ts.mjs e2e/stack/check.ts",
        "stack:serve": "node --import ./scripts/site/register-ts.mjs e2e/stack/main.ts serve",
        "stack:tick": "node --import ./scripts/site/register-ts.mjs e2e/stack/main.ts tick",
        "test": "JAVA_TOOL_OPTIONS='-XX:CICompilerCount=2 -Xmx6g' firebase emulators:exec --project demo-hcm --only auth,firestore,storage 'bash scripts/ci/run-emulated-tests.sh'",
        "test:e2e": "npm run test:e2e --workspace @hcm/e2e",
        "test:unit": "vitest run --coverage",
        "typecheck": "tsc -b"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.19.2",
        "@vitest/browser-playwright": "5.1.0",
        "@vitest/coverage-v8": "5.1.0",
        "@vitest/eslint-plugin": "1.6.28",
        "braces": "file:vendor/npm/braces",
        "dependency-cruiser": "18.7.2",
        "eslint": "10.15.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-lit": "2.3.1",
        "eslint-plugin-no-unsanitized": "4.1.5",
        "eslint-plugin-playwright": "2.12.2",
        "eslint-plugin-sonarjs": "4.2.2",
        "eslint-plugin-wc": "3.1.0",
        "firebase-tools": "15.36.0",
        "globals": "17.14.0",
        "html-validate": "11.21.1",
        "htmlhint": "1.9.2",
        "knip": "6.45.1",
        "markdownlint-cli2": "0.24.1",
        "minimatch": "file:vendor/npm/minimatch",
        "playwright": "1.65.1",
        "postcss-lit": "1.4.1",
        "prettier": "3.10.1",
        "sharp": "0.35.5",
        "stylelint": "18.0.0",
        "stylelint-config-standard": "41.0.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.2",
        "vite": "8.3.8",
        "vitest": "5.1.0",
        "zod": "4.6.7"
    },
    "overrides": {
        "@firebase/firestore@4.20.0": {
            "@grpc/grpc-js": "1.14.7"
        },
        "@opentelemetry/core": "2.12.0",
        "basic-ftp": "6.2.4",
        "braces": "$braces",
        "fast-xml-parser": "5.12.0",
        "gaxios@6.7.1": {
            "uuid": "11.1.1"
        },
        "glob": "14.0.3",
        "katex": "0.19.1",
        "minimatch": "$minimatch",
        "re2js": "2.9.1",
        "smol-toml": "1.9.1"
    }
}
