{
    "$schema": "./node_modules/firebase-tools/schema/firebase-config.json",
    "firestore": {
        "database": "(default)",
        "location": "nam5",
        "rules": "firebase/firestore.rules",
        "indexes": "firebase/firestore.indexes.json"
    },
    "storage": {
        "rules": "firebase/storage.rules"
    },
    "functions": [
        {
            "source": "functions/dist",
            "codebase": "default",
            "runtime": "nodejs24",
            "disallowLegacyRuntimeConfig": true,
            "ignore": [
                "node_modules",
                ".git",
                "*.local",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ],
            "predeploy": [
                "npm --prefix \"$PROJECT_DIR\" run build --workspace @hcm/functions"
            ]
        }
    ],
    "hosting": [
        {
            "cleanUrls": true,
            "trailingSlash": true,
            "ignore": [
                "**/.*",
                "**/*.map"
            ],
            "site": "bucurestiul-disparut",
            "public": "dist/hosting",
            "redirects": [
                {
                    "source": "/admin",
                    "destination": "https://bucurestiul-disparut-admin.web.app/admin/",
                    "type": 301
                },
                {
                    "regex": "^/admin/(?P<rest>|s|st|sta|star|start|starte|starter|starter\\.|starter\\.j|starter\\.js|starter\\.jso|[^s].*|s[^t].*|st[^a].*|sta[^r].*|star[^t].*|start[^e].*|starte[^r].*|starter[^\\.].*|starter\\.[^j].*|starter\\.j[^s].*|starter\\.js[^o].*|starter\\.jso[^n].*|starter\\.json.+)$",
                    "destination": "https://bucurestiul-disparut-admin.web.app/admin/:rest",
                    "type": 301
                },
                {
                    "regex": "^/admin$",
                    "destination": "/admin/",
                    "type": 301
                }
            ],
            "rewrites": [
                {
                    "regex": "^/[a-z0-9-]{2,32}/?$",
                    "destination": "/city/index.html"
                }
            ],
            "headers": [
                {
                    "source": "**",
                    "headers": [
                        {
                            "key": "Referrer-Policy",
                            "value": "strict-origin-when-cross-origin"
                        },
                        {
                            "key": "X-Content-Type-Options",
                            "value": "nosniff"
                        },
                        {
                            "key": "Permissions-Policy",
                            "value": "camera=(), microphone=(), geolocation=(self)"
                        }
                    ]
                },
                {
                    "regex": "^/[^.]*$",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache"
                        }
                    ]
                },
                {
                    "source": "**/*.@(html|js|mjs|css|json)",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache"
                        }
                    ]
                },
                {
                    "source": "**/*.webmanifest",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache"
                        },
                        {
                            "key": "Content-Type",
                            "value": "application/manifest+json"
                        }
                    ]
                }
            ]
        },
        {
            "cleanUrls": true,
            "trailingSlash": true,
            "ignore": [
                "**/.*",
                "**/*.map"
            ],
            "site": "bucurestiul-disparut-admin",
            "public": "dist/hosting-admin",
            "redirects": [
                {
                    "regex": "^/(?:index\\.html)?$",
                    "destination": "/admin/",
                    "type": 301
                },
                {
                    "regex": "^/(?P<city>|a|ad|adm|admi|[bcdefghijklmnopqrstuvwxyz0123456789\\-][abcdefghijklmnopqrstuvwxyz0123456789\\-]*|a[abcefghijklmnopqrstuvwxyz0123456789\\-][abcdefghijklmnopqrstuvwxyz0123456789\\-]*|ad[abcdefghijklnopqrstuvwxyz0123456789\\-][abcdefghijklmnopqrstuvwxyz0123456789\\-]*|adm[abcdefghjklmnopqrstuvwxyz0123456789\\-][abcdefghijklmnopqrstuvwxyz0123456789\\-]*|admi[abcdefghijklmopqrstuvwxyz0123456789\\-][abcdefghijklmnopqrstuvwxyz0123456789\\-]*|admin[abcdefghijklmnopqrstuvwxyz0123456789\\-]+)/?$",
                    "destination": "https://bucurestiul-disparut.web.app/:city/",
                    "type": 301
                }
            ],
            "rewrites": [
                {
                    "source": "/admin/**",
                    "destination": "/admin/index.html"
                }
            ],
            "headers": [
                {
                    "source": "**",
                    "headers": [
                        {
                            "key": "Referrer-Policy",
                            "value": "strict-origin-when-cross-origin"
                        },
                        {
                            "key": "X-Content-Type-Options",
                            "value": "nosniff"
                        },
                        {
                            "key": "Permissions-Policy",
                            "value": "camera=(), microphone=(), geolocation=(self)"
                        }
                    ]
                },
                {
                    "source": "/admin/**",
                    "headers": [
                        {
                            "key": "Content-Security-Policy",
                            "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://api.mapbox.com/mapbox-gl-js/ https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://www.googletagmanager.com; style-src 'self' https://api.mapbox.com/mapbox-gl-js/; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.run.app https://api.mapbox.com https://events.mapbox.com https://*.tiles.mapbox.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com http://127.0.0.1:8765 http://localhost:8765 https://planetarycomputer.microsoft.com; img-src 'self' data: blob: https://storage.googleapis.com https://firebasestorage.googleapis.com https://api.mapbox.com https://lh3.googleusercontent.com https://tile.openstreetmap.org https://planetarycomputer.microsoft.com https://*.google-analytics.com https://*.googletagmanager.com; frame-src 'self' https://bucurestiul-disparut.web.app https://bucurestiul-disparut.firebaseapp.com https://accounts.google.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; worker-src 'self' blob:; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
                        },
                        {
                            "key": "Content-Security-Policy-Report-Only",
                            "value": "require-trusted-types-for 'script'"
                        },
                        {
                            "key": "Cross-Origin-Opener-Policy",
                            "value": "same-origin-allow-popups"
                        }
                    ]
                },
                {
                    "regex": "^/[^.]*$",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache"
                        }
                    ]
                },
                {
                    "source": "**/*.@(html|js|mjs|css|json)",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache"
                        }
                    ]
                },
                {
                    "source": "**/*.webmanifest",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache"
                        },
                        {
                            "key": "Content-Type",
                            "value": "application/manifest+json"
                        }
                    ]
                },
                {
                    "source": "/admin/legacy/**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=86400"
                        }
                    ]
                },
                {
                    "source": "/admin/legacy/*/*.json",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache"
                        }
                    ]
                },
                {
                    "source": "/admin/install/**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=31536000, immutable"
                        }
                    ]
                },
                {
                    "source": "/admin/install/*/manifest.json",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache"
                        }
                    ]
                }
            ]
        }
    ],
    "emulators": {
        "singleProjectMode": true,
        "hub": {
            "host": "127.0.0.1",
            "port": 4400
        },
        "logging": {
            "host": "127.0.0.1",
            "port": 4500
        },
        "auth": {
            "host": "127.0.0.1",
            "port": 9099
        },
        "firestore": {
            "host": "127.0.0.1",
            "port": 8080,
            "websocketPort": 9150
        },
        "storage": {
            "host": "127.0.0.1",
            "port": 9199
        },
        "functions": {
            "host": "127.0.0.1",
            "port": 5001
        },
        "hosting": {
            "host": "127.0.0.1",
            "port": 5000
        },
        "pubsub": {
            "host": "127.0.0.1",
            "port": 8085
        },
        "tasks": {
            "host": "127.0.0.1",
            "port": 9499
        },
        "ui": {
            "enabled": false
        }
    }
}
